{
  "//ConnectionStrings": "Intentionally unset. Supply ConnectionStrings__DefaultConnection from the environment; local development uses appsettings.Development.json. A default here would silently mask a missing variable and send the app at localhost.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JWT": {
    "SecretKey": "YourSuperSecretKeyThatIsAtLeast32CharactersLongForSecurityPurposes!@#$%^&*()",
    "Issuer": "hallbookingapi",
    "Audience": "hallbookingapp",
    "ExpiryInHours": 1
  },
  "Invoice": {
    "AutoGenerateOnConfirmation": true,
    "AutoGenerateTriggerStatuses": [ "Confirmed", "ReadyForPayment" ]
  },
  "BusinessRules": {
    "TaxRate": 0.15,
    "MaxBookingWindowDays": 365,
    "HallOpeningTime": "08:00:00",
    "HallClosingTime": "23:00:00",
    "MinBookingDurationHours": 2,
    "MaxBookingDurationHours": 16,
    "InvoicePaymentDueDays": 30,
    "IdempotencyKeyExpirationHours": 24,
    "MaxRefundDays": 14
  },
  "AllowedHosts": "*",
  "Seed": {
    "//": "AdminEmail/AdminPassword override the built-in admin credentials (SEED__ADMINEMAIL, SEED__ADMINPASSWORD). DemoData=true opts a non-Development environment into the sample halls, vendors and bookings.",
    "AdminEmail": "",
    "AdminPassword": "",
    "DemoData": "false"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/hallapp-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  }
}
