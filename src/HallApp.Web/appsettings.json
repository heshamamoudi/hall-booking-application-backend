{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=localhost;Initial Catalog=HallApp;User Id=SA;Password=YourStrongPassword!;Integrated Security=False;Connect Timeout=60;Encrypt=False;Trust Server Certificate=False;Application Intent=ReadWrite;Multi Subnet Failover=False;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JWT": {
    "SecretKey": "YourSuperSecretKeyThatIsAtLeast32CharactersLongForSecurityPurposes!@#$%^&*()",
    "Issuer": "hallbookingapi",
    "Audience": "hallbookingapp",
    "ExpiryInHours": 1
  },
  "Invoice": {
    "AutoGenerateOnConfirmation": true,
    "AutoGenerateTriggerStatuses": [ "Confirmed", "ReadyForPayment" ]
  },
  "BusinessRules": {
    "TaxRate": 0.15,
    "MaxBookingWindowDays": 365,
    "HallOpeningTime": "08:00:00",
    "HallClosingTime": "23:00:00",
    "MinBookingDurationHours": 2,
    "MaxBookingDurationHours": 16,
    "InvoicePaymentDueDays": 30,
    "IdempotencyKeyExpirationHours": 24,
    "MaxRefundDays": 14
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/hallapp-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  }
}
