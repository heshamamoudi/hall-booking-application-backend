# ===========================================================================
# Zawaji API - deployment environment variables
#
# Copy the values you need into the deploy form or the platform's environment
# settings. .NET maps a double underscore to the ":" section separator, so
# CORS__AllowedOrigins sets the "CORS:AllowedOrigins" configuration key.
#
# Uncommented entries below must be set. Commented entries already have a
# working default and only need a value to override it.
# ===========================================================================

# --- Required --------------------------------------------------------------

ASPNETCORE_ENVIRONMENT=Production

# The app deliberately refuses to start in Production without this. Comma
# separated, no trailing slashes, and the scheme has to match what the browser
# actually requests.
CORS__AllowedOrigins=https://zawajeapp.com,https://www.zawajeapp.com

# Tokens are signed with HMAC-SHA512, so this must be at least 64 characters -
# a shorter key is rejected at startup. Generate a fresh value per environment
# and never reuse the placeholder committed in appsettings.json.
#   openssl rand -base64 64 | tr -d '\n'
JWT__SecretKey=

# --- Database --------------------------------------------------------------
# The platform injects this when a database is requested. Set it by hand only
# when pointing at a database you manage yourself. The provider is detected
# from the string's shape.
#   PostgreSQL  Host=host;Port=5432;Database=db;Username=user;Password=pass
#   SQL Server  Server=host;Database=db;User Id=user;Password=pass;Encrypt=True
# ConnectionStrings__DefaultConnection=

# --- Seeding ---------------------------------------------------------------
# Roles, the administrator account, platform settings and vendor types are
# seeded in every environment. Without the two values below the admin is
# created with the built-in development password and a warning is logged, so
# set them before the first boot.
SEED__ADMINEMAIL=
SEED__ADMINPASSWORD=

# Set to true to also seed the demo dataset - sample customers, hall and vendor
# organisations, halls, bookings and invoices. Automatic in Development. Leave
# unset for a real deployment; turn it on for one boot if you want the demo
# data, then remove it.
# SEED__DEMODATA=false

# --- JWT -------------------------------------------------------------------
# JWT__Issuer=hallbookingapi
# JWT__Audience=hallbookingapp
# JWT__ExpiryInHours=1

# --- Uploads ---------------------------------------------------------------
# Set by the Dockerfile to a volume that survives restarts and stays writable
# under the read-only root filesystem. Override only if you mount storage
# somewhere else - the path must be writable by uid 1654.
# Uploads__Path=/data/uploads

# --- HTTP ------------------------------------------------------------------
# Set by the Dockerfile. TLS terminates at the edge, so the app speaks plain
# HTTP and must bind 0.0.0.0 (the + wildcard), never localhost.
# ASPNETCORE_URLS=http://+:8080

# --- API docs --------------------------------------------------------------
# Swagger is off outside Development. Turning it on exposes the full API
# surface publicly.
# SWAGGER__ENABLED=false

# --- Payments --------------------------------------------------------------
# Only needed once payments are live. WebhookSecret is required for the
# HyperPay webhook endpoint to accept anything - unsigned callbacks are
# rejected when it is empty.
# PAYMENT__TESTMODE=true
# PAYMENT__DEFAULTCURRENCY=SAR
# PAYMENT__PAYMENTTIMEOUTMINUTES=30
# PAYMENT__HYPERPAY__ENABLED=true
# PAYMENT__HYPERPAY__ENTITYID=
# PAYMENT__HYPERPAY__ACCESSTOKEN=
# PAYMENT__HYPERPAY__BASEURL=https://eu-test.oppwa.com
# PAYMENT__HYPERPAY__WEBHOOKSECRET=
# PAYMENT__TABBY__ENABLED=false
# PAYMENT__TABBY__PUBLICKEY=
# PAYMENT__TABBY__SECRETKEY=
# PAYMENT__TABBY__MERCHANTCODE=
# PAYMENT__TABBY__WEBHOOKSECRET=
# PAYMENT__TAMARA__ENABLED=false
# PAYMENT__TAMARA__APITOKEN=
# PAYMENT__TAMARA__NOTIFICATIONTOKEN=
# PAYMENT__TAMARA__WEBHOOKSECRET=

# --- Data protection -------------------------------------------------------
# Keys are persisted to the database and encrypted at rest there. Supply a
# certificate to add a second layer.
# DATAPROTECTION__CERTIFICATEPATH=
# DATAPROTECTION__CERTIFICATEPASSWORD=
# DATAPROTECTION__CERTIFICATETHUMBPRINT=

# --- Business rules --------------------------------------------------------
# BUSINESSRULES__TAXRATE=0.15
# BUSINESSRULES__MAXBOOKINGWINDOWDAYS=365
# BUSINESSRULES__HALLOPENINGTIME=08:00:00
# BUSINESSRULES__HALLCLOSINGTIME=23:00:00
# BUSINESSRULES__MINBOOKINGDURATIONHOURS=2
# BUSINESSRULES__MAXBOOKINGDURATIONHOURS=16
# BUSINESSRULES__INVOICEPAYMENTDUEDAYS=30
# BUSINESSRULES__IDEMPOTENCYKEYEXPIRATIONHOURS=24
# BUSINESSRULES__MAXREFUNDDAYS=14

# --- Invoicing -------------------------------------------------------------
# INVOICE__AUTOGENERATEONCONFIRMATION=true

# --- Logging ---------------------------------------------------------------
# Serilog writes to the console; the platform captures and rotates it.
# LOGGING__LOGLEVEL__DEFAULT=Information
# LOGGING__LOGLEVEL__MICROSOFT=Warning
