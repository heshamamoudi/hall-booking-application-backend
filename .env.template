# ===========================================================================
# Zawaji API - deployment environment variables
#
# Every key the application reads is listed here and left ENABLED, because a
# commented line is invisible to anything that reads this file to decide what
# to prompt for. That invisibility is what caused the first deployment to fail:
# the connection string was never asked for, so it was never set.
#
# .NET maps a double underscore to the ":" section separator, so
# CORS__AllowedOrigins sets the "CORS:AllowedOrigins" configuration key.
#
# Values below are the real defaults - safe to deploy as-is. Keys left EMPTY
# are the ones you must fill in: they are secrets, or environment-specific,
# and there is no sane default for them.
#
# Do not blank out a key that has a value here. An empty string is not the same
# as unset: it overrides the built-in default with "", and the typed settings
# (numbers, booleans, timespans) fail to bind when they get one.
# ===========================================================================

# --- Must be filled in -----------------------------------------------------

# Supplied by the platform when a database is requested. There is no fallback:
# the app refuses to start without it rather than quietly aiming at localhost.
# The provider is detected from the string's shape.
#   PostgreSQL  Host=host;Port=5432;Database=db;Username=user;Password=pass
#   SQL Server  Server=host;Database=db;User Id=user;Password=pass;Encrypt=True
ConnectionStrings__DefaultConnection=

# Signing key for JWTs. At least 64 characters - tokens use HMAC-SHA512 and a
# shorter key is rejected at startup. Generate a fresh one per environment:
#   openssl rand -base64 64 | tr -d '\n'
JWT__SecretKey=

# Who may call the API from a browser. Comma separated, no trailing slashes,
# and the scheme must match what the browser actually requests. The app
# deliberately refuses to start in Production without this.
CORS__AllowedOrigins=https://zawajeapp.com,https://www.zawajeapp.com

# The administrator account, created on first boot. Without these the admin is
# created with the built-in development password and a warning is logged.
SEED__ADMINEMAIL=
SEED__ADMINPASSWORD=

# --- Environment -----------------------------------------------------------

ASPNETCORE_ENVIRONMENT=Production

# TLS terminates at the edge, so the app speaks plain HTTP and must bind
# 0.0.0.0 (the + wildcard), never localhost. Also set in the Dockerfile.
ASPNETCORE_URLS=http://+:8080

# --- Seeding ---------------------------------------------------------------

# Roles, the administrator, platform settings and vendor types always seed.
# This adds the demo dataset: sample customers, organisations, halls, vendors,
# bookings and invoices. Automatic in Development. Turn on for one boot if you
# want the sample data in a deployed environment, then set it back to false.
SEED__DEMODATA=false

# --- JWT -------------------------------------------------------------------

JWT__Issuer=hallbookingapi
JWT__Audience=hallbookingapp
JWT__ExpiryInHours=1

# --- Uploads ---------------------------------------------------------------

# A volume, so uploaded images stay writable under the read-only root
# filesystem and survive restarts. Change only if you mount storage elsewhere;
# the path must be writable by uid 1654.
Uploads__Path=/data/uploads

# --- API docs --------------------------------------------------------------

# Turning this on exposes the full API surface publicly.
SWAGGER__ENABLED=false

# --- Payments --------------------------------------------------------------
# Credentials are empty until payments go live. An empty WebhookSecret means
# the matching webhook endpoint rejects everything, which is the safe default.

PAYMENT__TESTMODE=true
PAYMENT__DEFAULTCURRENCY=SAR
PAYMENT__PAYMENTTIMEOUTMINUTES=30

PAYMENT__HYPERPAY__ENABLED=true
PAYMENT__HYPERPAY__ENTITYID=
PAYMENT__HYPERPAY__ACCESSTOKEN=
PAYMENT__HYPERPAY__BASEURL=https://eu-test.oppwa.com
PAYMENT__HYPERPAY__WEBHOOKSECRET=
PAYMENT__HYPERPAY__ENABLE3DSECURE=true

PAYMENT__TABBY__ENABLED=false
PAYMENT__TABBY__PUBLICKEY=
PAYMENT__TABBY__SECRETKEY=
PAYMENT__TABBY__MERCHANTCODE=
PAYMENT__TABBY__BASEURL=https://api.tabby.ai/api/v2
PAYMENT__TABBY__WEBHOOKSECRET=
PAYMENT__TABBY__MINORDERAMOUNT=100
PAYMENT__TABBY__MAXORDERAMOUNT=5000

PAYMENT__TAMARA__ENABLED=false
PAYMENT__TAMARA__APITOKEN=
PAYMENT__TAMARA__MERCHANTURL=
PAYMENT__TAMARA__NOTIFICATIONTOKEN=
PAYMENT__TAMARA__BASEURL=https://api-sandbox.tamara.co
PAYMENT__TAMARA__WEBHOOKSECRET=
PAYMENT__TAMARA__MINORDERAMOUNT=100
PAYMENT__TAMARA__MAXORDERAMOUNT=5000
PAYMENT__TAMARA__COUNTRYCODE=SA

# List-valued settings cannot be expressed as one variable. .NET reads them by
# index, so add them individually if you need to change the defaults:
#   PAYMENT__HYPERPAY__ENABLEDPAYMENTBRANDS__0=VISA
#   PAYMENT__HYPERPAY__ENABLEDPAYMENTBRANDS__1=MASTER

# --- Data protection -------------------------------------------------------
# Keys are persisted to the database and encrypted at rest there. A certificate
# adds a second layer; leaving these empty is supported and expected.

DATAPROTECTION__CERTIFICATEPATH=
DATAPROTECTION__CERTIFICATEPASSWORD=
DATAPROTECTION__CERTIFICATETHUMBPRINT=

# --- Business rules --------------------------------------------------------

BUSINESSRULES__TAXRATE=0.15
BUSINESSRULES__MAXBOOKINGWINDOWDAYS=365
BUSINESSRULES__HALLOPENINGTIME=08:00:00
BUSINESSRULES__HALLCLOSINGTIME=23:00:00
BUSINESSRULES__MINBOOKINGDURATIONHOURS=2
BUSINESSRULES__MAXBOOKINGDURATIONHOURS=16
BUSINESSRULES__INVOICEPAYMENTDUEDAYS=30
BUSINESSRULES__IDEMPOTENCYKEYEXPIRATIONHOURS=24
BUSINESSRULES__MAXREFUNDDAYS=14

# --- Invoicing -------------------------------------------------------------

INVOICE__AUTOGENERATEONCONFIRMATION=true

# --- AutoMapper ------------------------------------------------------------
# AutoMapper 15+ is commercially licensed. Zawaji qualifies for the free
# Community tier (under $5M revenue, under $10M outside capital), but the key
# still has to be registered and set here - without it the app logs a licence
# warning on every start. Get one at https://automapper.io
AUTOMAPPER__LICENSEKEY=

# --- Logging ---------------------------------------------------------------
# Serilog writes to the console; the platform captures and rotates it.

LOGGING__LOGLEVEL__DEFAULT=Information
LOGGING__LOGLEVEL__MICROSOFT=Warning
