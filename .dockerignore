# Keeps the build context small and keeps out anything that must never reach an
# image. This Dockerfile contains `COPY . .`, so the context IS the image's
# build stage - every exclusion below is load-bearing, not tidiness.
#
# ---- secrets ---------------------------------------------------------------
.env
.env.*
**/.env
**/.env.*
!.env.template
!**/.env.template
!.env.example
!**/.env.example

# ---- build output ----------------------------------------------------------
**/bin/
**/obj/
**/out/
**/node_modules/

# ---- vcs, editors ----------------------------------------------------------
.git
.git/
**/.git/
.gitignore
.vs/
**/.vs/
.vscode/
.idea/
*.user
*.suo

# ---- documentation, tests --------------------------------------------------
*.md
docs/
tests/

# ---- local settings --------------------------------------------------------
appsettings.Development.json
appsettings.*.json
!appsettings.json
!appsettings.Production.template.json

# ---- other -----------------------------------------------------------------
*.log
logs/
DataProtection-Keys/
